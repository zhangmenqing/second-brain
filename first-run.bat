@echo off
REM =====================================================================
REM  本机首次运行：注册定时任务 + 首次同步（用来记住 GitHub 令牌）
REM  只需双击一次。若注册任务提示权限不足，请右键「以管理员身份运行」
REM =====================================================================

echo ================================================================
echo   第二大脑工作台 - 本机首次初始化
echo ================================================================
echo.
echo  [1/2] 注册每小时自动同步任务（WorkbenchAutoSync）...
schtasks /create /tn "WorkbenchAutoSync" /tr "E:\workbench\sync.bat" /sc hourly /mo 1 /st 00:00 /f

echo.
echo  [2/2] 做一次同步，以便记住你的 GitHub 令牌
echo        稍后会弹出 GitHub 登录框：
echo          用户名：zhangmenqing
echo          密码：你的 GitHub 私人访问令牌（token，不是登录密码）
echo.
call sync.bat

echo.
echo ================================================================
echo   完成！以后每小时自动同步，你无需再手动操作。
echo   也可随时双击 sync.bat 立即同步。
echo ================================================================
pause
